# Copia este archivo como ".env" y ajusta los valores según tu entorno

# Ruta del modelo YOLOv8 (usa "yolov8n.pt" para probar rápido con el modelo base,
# o la ruta a tu modelo entrenado, ej: "train_yolo/runs/detect/train/weights/best.pt")
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35

# Base de datos (SQLite por defecto; para MySQL usa algo como:
# mysql+pymysql://usuario:password@localhost/incidencias_db)
DATABASE_URL=sqlite:///./incidencias.db

# Orígenes permitidos para CORS (frontend React)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

DEBUG=True
